---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - resources/postgres-pv.yml
  - github.com/ansible/awx-operator/config/default?ref={{ latest_release["json"]["tag_name"] }}
  - resources/awx.yml
  - resources/project-pvc.yml
  - resources/project-pv.yml
# Set the image tags to match the git version from above
images:
  - name: quay.io/ansible/awx-operator
    newTag: '{{ latest_release["json"]["tag_name"] }}'
# Specify a custom namespace in which to install AWX
namespace: "{{ awx_namespace }}"
